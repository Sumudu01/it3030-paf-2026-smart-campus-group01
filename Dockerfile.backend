version: '3.8'

services:
  db:
    image: postgres:15
    container_name: smartcampus-db
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-smartcampus}
      POSTGRES_USER: ${POSTGRES_USER:-smartcampus}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-password}
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./db/init.sql:/docker-entrypoint-initdb.d/init.sql
    networks:
      - smartcampus-network

  backend:
    build:
      context: .
      dockerfile: Dockerfile.backend
    container_name: smartcampus-backend
    environment:
      SPRING_PROFILES_ACTIVE: docker
      SPRING_DATASOURCE_URL: jdbc:postgresql://db:5432/${POSTGRES_DB:-smartcampus}
      SPRING_DATASOURCE_USERNAME: ${POSTGRES_USER:-smartcampus}
      SPRING_DATASOURCE_PASSWORD: ${POSTGRES_PASSWORD:-password}
      GOOGLE_CLIENT_ID: ${GOOGLE_CLIENT_ID}
      GOOGLE_CLIENT_SECRET: ${GOOGLE_CLIENT_SECRET}
    ports:
      - "8080:8080"
    depends_on:
      - db
    volumes:
      - ./smartcampusoperationshub:/app
      - /app/target
    networks:
      - smartcampus-network
    command: ["./mvnw", "spring-boot:run", "-Dspring-boot.run.jvmArguments=-Xdebug -Xrunjdwp:transport=dt_socket,server=y,suspend=n,address=*:5005"]

  frontend:
    build:
      context: .
      dockerfile: Dockerfile.frontend
    container_name: smartcampus-frontend
    environment:
      REACT_APP_API_BASE_URL: http://localhost:8080
    ports:
      - "3000:3000"
    volumes:
      - ./frontend:/app
      - /app/node_modules
    networks:
      - smartcampus-network
    command: ["npm", "start"]

  adminer:
    image: adminer
    container_name: smartcampus-adminer
    ports:
      - "8081:8080"
    depends_on:
      - db
    networks:
      - smartcampus-network

volumes:
  postgres_data:

networks:
  smartcampus-network:
    driver: bridge</content>
<parameter name="filePath">docker-compose.yml